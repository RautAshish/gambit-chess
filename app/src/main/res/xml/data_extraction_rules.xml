<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup keeps settings (no token transplant across restore of the
         SAME account is a low risk). Device-transfer excludes it, since moving
         tokens to a different physical device is the identity-hijack vector. -->
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
