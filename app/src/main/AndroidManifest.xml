<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false (owner verdict, field incident): Google Auto Backup
         restored a pre-deletion saved-games snapshot after uninstall/reinstall,
         contradicting PRIVACY.md's "only on your device" / "deleting the app
         deletes all local data". Opting out makes both claims literally true and
         subsumes the old backup_rules' narrower goal (blocking online-identity
         transplant via device transfer) — with no backup there is nothing to
         transplant. Continuity across devices is planned as user-held PGN
         export instead (backlog: share-PGN). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Emersion Chess"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gambit">
        <activity android:name=".MainActivity" android:exported="true">
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
